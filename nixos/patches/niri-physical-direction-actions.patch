     );
+}
+
+#[test]
+fn vertical_main_axis_physical_move_actions_keep_screen_directions() {
+    let mut options = Options::default();
+    options.layout.main_axis = MainAxis::Vertical;
+
+    let mut layout = check_ops_with_options(
+        options,
+        [
+            Op::AddOutput(1),
+            Op::AddWindow {
+                params: TestWindowParams::new(1),
+            },
+            Op::ToggleWindowFloating { id: None },
+        ],
+    );
+
+    let window_pos = |layout: &Layout<TestWindow>| {
+        let mut pos = None;
+        layout.with_windows(|win, _, _, window_layout| {
+            if *win.id() == 1 {
+                pos = window_layout.tile_pos_in_workspace_view;
+            }
+        });
+        pos.unwrap()
+    };
+
+    let start = window_pos(&layout);
+    layout.move_physical_right();
+    let after_right = window_pos(&layout);
+    layout.move_physical_down();
+    let after_down = window_pos(&layout);
+
+    assert!(after_right.0 > start.0);
+    assert_eq!(after_right.1, start.1);
+    assert_eq!(after_down.0, after_right.0);
+    assert!(after_down.1 > after_right.1);
 }
 
