+            .backend
+            .create_virtual_output(&mut state.niri, 1920, 1080, 60, Some("virt".to_owned()))
+            .unwrap()
+    };
+
+    {
+        let state = f.niri_state();
+        state.modify_output_config(&name, |config| {
+            config.off = true;
+        });
+    }
+
+    {
+        let state = f.niri_state();
+        state
+            .backend
+            .remove_virtual_output(&mut state.niri, &name)
+            .unwrap();
+    }
+}
