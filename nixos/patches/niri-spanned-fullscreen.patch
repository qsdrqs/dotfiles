new file mode 100644
--- /dev/null
+++ b/src/spanned_fullscreen.rs
@@ -0,0 +1,205 @@
+use smithay::desktop::space::SpaceElement as _;
+use smithay::desktop::Window;
+use smithay::output::Output;
+use smithay::utils::{Logical, Point, Rectangle};
+
+use crate::layout::LayoutElement as _;
+use crate::niri::Niri;
+use crate::window::mapped::Mapped;
+
+#[derive(Debug)]
+pub(crate) struct SpannedFullscreen {
+    pub(crate) window: Window,
+    pub(crate) outputs: Vec<(Output, Rectangle<i32, Logical>)>,
+    geometry: Rectangle<i32, Logical>,
+    was_fullscreen: bool,
+    was_windowed_fullscreen: bool,
+}
+
+impl SpannedFullscreen {
+    pub(crate) fn covers_output(&self, output: &Output) -> bool {
+        self.outputs.iter().any(|(covered, _)| covered == output)
+    }
+}
+
+impl Niri {
+    pub fn toggle_spanned_fullscreen(&mut self) {
+        let Some(window) = self.layout.focus().map(|mapped| mapped.window.clone()) else {
+            return;
+        };
+
+        if self
+            .spanned_fullscreen
+            .as_ref()
+            .is_some_and(|span| span.window == window)
+        {
+            self.end_spanned_fullscreen(true);
+            return;
+        }
+        self.end_spanned_fullscreen(true);
+
+        let outputs: Vec<_> = self
+            .global_space
+            .outputs()
+            .map(|output| {
+                let geometry = self.global_space.output_geometry(output).unwrap();
+                (output.clone(), geometry)
+            })
+            .collect();
+        if outputs.len() < 2 {
+            return;
+        }
+        let geometry = outputs
+            .iter()
+            .map(|(_, geometry)| *geometry)
+            .reduce(|a, b| a.merge(b))
+            .unwrap();
+
+        let Some((_, mapped)) = self
+            .layout
+            .windows()
+            .find(|(_, mapped)| mapped.window == window)
+        else {
+            return;
+        };
+        let was_fullscreen = mapped.pending_sizing_mode().is_fullscreen();
+        let was_windowed_fullscreen = mapped.is_pending_windowed_fullscreen();
+
+        self.layout.set_fullscreen(&window, true);
+        let mut configured = false;
+        self.layout.with_windows_mut(|mapped, _| {
+            if mapped.window == window && mapped.pending_sizing_mode().is_fullscreen() {
+                mapped.set_fullscreen_span_size(Some(geometry.size));
+                for (output, _) in &outputs {
+                    mapped.output_enter(output);
+                }
+                configured = true;
+            }
+        });
+        if !configured {
+            return;
+        }
+
+        self.spanned_fullscreen = Some(SpannedFullscreen {
+            window,
+            outputs,
+            geometry,
+            was_fullscreen,
+            was_windowed_fullscreen,
+        });
+        self.queue_redraw_all();
+    }
+
+    pub(crate) fn end_spanned_fullscreen(&mut self, restore: bool) {
+        let Some(span) = self.spanned_fullscreen.take() else {
+            return;
+        };
+
+        let mut owner = None;
+        let mut mapped_window = false;
+        self.layout.with_windows_mut(|mapped, output| {
+            if mapped.window == span.window {
+                mapped.set_fullscreen_span_size(None);
+                owner = output.cloned();
+                if let Some(output) = output {
+                    mapped.set_preferred_scale_transform(
+                        output.current_scale(),
+                        output.current_transform(),
+                    );
+                }
+                mapped_window = true;
+            }
+        });
+        for (output, _) in &span.outputs {
+            if owner.as_ref() != Some(output) {
+                span.window.output_leave(output);
+            }
+        }
+
+        if restore && mapped_window {
+            self.layout
+                .set_fullscreen(&span.window, span.was_fullscreen);
+            if span.was_windowed_fullscreen {
+                self.layout.toggle_windowed_fullscreen(&span.window);
+            }
+        }
+        self.queue_redraw_all();
+    }
+
+    pub(crate) fn refresh_spanned_fullscreen(&mut self) {
+        let Some(span) = &self.spanned_fullscreen else {
+            return;
+        };
+        let mapped = self
+            .layout
+            .windows()
+            .find(|(_, mapped)| mapped.window == span.window)
+            .map(|(_, mapped)| mapped);
+        if !mapped.is_some_and(|mapped| mapped.pending_sizing_mode().is_fullscreen()) {
+            self.end_spanned_fullscreen(false);
+            return;
+        }
+
+        let output_changed = self.global_space.outputs().count() != span.outputs.len()
+            || span.outputs.iter().any(|(output, geometry)| {
+                self.global_space.output_geometry(output).as_ref() != Some(geometry)
+            });
+        let focus_changed = self
+            .layout
+            .focus()
+            .is_none_or(|mapped| mapped.window != span.window);
+        if output_changed || focus_changed || self.layout.is_overview_open() {
+            self.end_spanned_fullscreen(true);
+            return;
+        }
+
+        let preferred = span
+            .outputs
+            .iter()
+            .map(|(output, _)| output)
+            .max_by(|a, b| {
+                a.current_scale()
+                    .fractional_scale()
+                    .total_cmp(&b.current_scale().fractional_scale())
+            })
+            .unwrap();
+        self.layout.with_windows_mut(|mapped, _| {
+            if mapped.window == span.window {
+                mapped.set_preferred_scale_transform(
+                    preferred.current_scale(),
+                    preferred.current_transform(),
+                );
+            }
+        });
+    }
+
+    pub(crate) fn spanned_fullscreen_for_output(
+        &self,
+        output: &Output,
+    ) -> Option<(&Mapped, Point<f64, Logical>)> {
+        let span = self.spanned_fullscreen.as_ref()?;
+        if !span.covers_output(output) {
+            return None;
+        }
+        let (_, mapped) = self
+            .layout
+            .windows()
+            .find(|(_, mapped)| mapped.window == span.window)?;
+        let output_geometry = self.global_space.output_geometry(output)?;
+        let location = (span.geometry.loc - output_geometry.loc).to_f64();
+        Some((mapped, location))
+    }
+
+    pub(crate) fn windows_rendered_on_output(
+        &self,
+        output: &Output,
+    ) -> impl Iterator<Item = &Mapped> {
+        let spanned = self
+            .spanned_fullscreen_for_output(output)
+            .map(|(mapped, _)| mapped);
+        self.layout
+            .windows_for_output(output)
+            .filter(move |mapped| spanned.is_none_or(|span| span.window != mapped.window))
+            .chain(spanned)
+    }
+}
