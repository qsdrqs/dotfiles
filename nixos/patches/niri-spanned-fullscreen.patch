+#[test]
+fn egl_spanned_fullscreen_renders_and_updates_secondary_output() {
+    let (mut f, id, surface) = set_up();
+    f.niri().hotkey_overlay.hide();
+    f.niri_state().backend.headless().add_renderer().unwrap();
+    f.niri().toggle_spanned_fullscreen();
+    f.double_roundtrip(id);
+
+    let window = f.client(id).window(&surface);
+    let buffer = window
+        .spbm
+        .create_u32_rgba_buffer(u32::MAX, 0, 0, u32::MAX, &window.qh, ());
+    window.surface.attach(Some(&buffer), 0, 0);
+    window.set_size(3200, 1080);
+    window.ack_last_and_commit();
+    f.double_roundtrip(id);
+    f.niri_complete_animations();
+    f.niri().update_render_elements(None);
+
+    let second = f.niri_output(2);
+    let state = f.niri_state();
+    let states = state
+        .backend
+        .with_primary_renderer(|renderer| {
+            let elements = state.niri.render_to_vec(
+                RenderCtx {
+                    renderer,
+                    target: RenderTarget::Output,
+                    xray: None,
+                },
+                &second,
+                false,
+            );
+            let span = elements
+                .iter()
+                .find(|element| matches!(element, OutputRenderElements::SpannedFullscreen(_)))
+                .unwrap();
+            assert_eq!(
+                span.geometry(Scale::from(1.)),
+                Rectangle::new(Point::from((-1920, 0)), Size::from((3200, 1080)),)
+            );
+
+            let mut damage_tracker = OutputDamageTracker::from_output(&second);
+            let (_, states) = damage_tracker.damage_output(0, &elements).unwrap();
+            let pixels = render_helpers::render_to_vec(
+                renderer,
+                Size::from((1280, 720)),
+                Scale::from(1.),
+                Transform::Normal,
+                Fourcc::Abgr8888,
+                elements.iter().rev(),
+            )
+            .unwrap();
+            (states, pixels)
+        })
+        .unwrap();
+    let (states, pixels) = states;
+    state.niri.update_primary_scanout_output(&second, &states);
+    let mapped = state.niri.layout.focus().unwrap();
+    let primary = with_states(mapped.toplevel().wl_surface(), |states| {
+        surface_primary_scanout_output(mapped.toplevel().wl_surface(), states)
+    });
+    assert_eq!(primary, Some(second.clone()));
+    assert!(pixels
+        .chunks_exact(4)
+        .all(|pixel| pixel == [255, 0, 0, 255]));
+
+    let done = Arc::<SyncData>::default();
+    let window = f.client(id).window(&surface);
+    window.surface.frame(&window.qh, done.clone());
+    window.commit();
+    f.double_roundtrip(id);
+    f.niri().send_frame_callbacks(&second);
+    f.double_roundtrip(id);
+    assert!(done.done.load(Ordering::Relaxed));
+}
