+#[test]
+fn spanned_fullscreen_size_input_and_restore() {
+    let (mut f, id, surface) = set_up();
+    let mapped = f.niri().layout.focus().unwrap();
+    let original_size = mapped.expected_size();
+    let window_id = mapped.window.clone();
+    let owner = f.niri().layout.active_output().unwrap().clone();
+
+    f.niri().toggle_spanned_fullscreen();
+    f.double_roundtrip(id);
+    let configure = &f
+        .client(id)
+        .window(&surface)
+        .configures_received
+        .last()
+        .unwrap()
+        .1;
+    assert_eq!(configure.size, (3200, 1080));
+    assert_eq!(configure.bounds, Some((3200, 1080)));
+    assert!(configure.states.contains(&xdg_toplevel::State::Fullscreen));
+
+    let window = f.client(id).window(&surface);
+    window.set_size(3200, 1080);
+    window.ack_last_and_commit();
+    f.double_roundtrip(id);
+
+    let under = f.niri().contents_under(Point::from((2500., 100.)));
+    assert_eq!(under.window.as_ref().unwrap().0, window_id);
+    assert!(under.surface.is_some());
+    f.niri().handle_focus_follows_mouse(&under);
+    assert_eq!(f.niri().layout.active_output(), Some(&owner));
+    assert!(f.niri().spanned_fullscreen.is_some());
+    assert_eq!(
+        f.niri().layout.popup_target_rect(&window_id, false),
+        Rectangle::from_size(Size::from((3200., 1080.))),
+    );
+
+    for state in f.niri().output_state.values_mut() {
+        state.redraw_state = RedrawState::Idle;
+    }
