+    f.double_roundtrip(id);
+    assert!(f.niri().spanned_fullscreen.is_none());
+    let mapped = f.niri().layout.focus().unwrap();
+    assert!(!mapped.pending_sizing_mode().is_fullscreen());
+    assert_eq!(mapped.expected_size(), original_size);
