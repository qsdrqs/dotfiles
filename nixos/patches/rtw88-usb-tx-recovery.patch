+static bool rtw_usb_tx_cancelled(int status)
+{
+	return status == -ENOENT || status == -ECONNRESET ||
+	       status == -ENODEV || status == -ESHUTDOWN;
+}
+
+static void rtw_usb_tx_status(struct rtw_usb *rtwusb, int ep, int status,
+			      int length, int actual)
+{
+	struct rtw_dev *rtwdev = rtwusb->rtwdev;
+	enum rtw_usb_tx_state *state = &rtwusb->tx_state[ep];
+
+	lockdep_assert_held(&rtwusb->tx_lock);
+
+	if (rtwusb->tx_stopped || rtw_usb_tx_cancelled(status))
+		return;
+
+	if (!status) {
+		if (*state == RTW_USB_TX_PROBING && actual == length) {
+			*state = RTW_USB_TX_READY;
+			dev_info(rtwdev->dev,
+				 "USB TX ep 0x%02x resumed: %d/%d bytes\n",
+				 rtwusb->out_ep[ep], actual, length);
+			queue_work(rtwusb->txwq, &rtwusb->tx_work);
+		}
+		return;
+	}
+
+	if (*state == RTW_USB_TX_PROBING) {
+		*state = RTW_USB_TX_FAILED;
+		dev_err(rtwdev->dev,
+			"USB TX ep 0x%02x recovery failed: status %d, %d/%d bytes\n",
+			rtwusb->out_ep[ep], status, actual, length);
+	} else if (*state == RTW_USB_TX_READY &&
+		   (status == -EPROTO || status == -EPIPE)) {
+		*state = RTW_USB_TX_RECOVERING;
+		dev_warn_ratelimited(rtwdev->dev,
+				     "USB TX ep 0x%02x failed: status %d, %d/%d bytes; scheduling recovery\n",
+				     rtwusb->out_ep[ep], status, actual, length);
+	} else {
+		return;
+	}
+
+	rtwusb->tx_recovery_pending |= BIT(ep);
+	queue_work(rtwusb->txwq, &rtwusb->tx_recovery_work);
+}
+
+static void rtw_usb_tx_recovery_work(struct work_struct *work)
+{
+	struct rtw_usb *rtwusb = container_of(work, struct rtw_usb,
+					    tx_recovery_work);
+	struct rtw_dev *rtwdev = rtwusb->rtwdev;
+	unsigned long flags;
+	bool recover, failed;
+	int ep, ret;
+
+	/* TX work is serialized here; direct H2C writers hold this mutex. */
+	mutex_lock(&rtwdev->mutex);
+	for (ep = 0; ep < rtwdev->hci.bulkout_num; ep++) {
+		spin_lock_irqsave(&rtwusb->tx_lock, flags);
+		if (rtwusb->tx_stopped) {
+			spin_unlock_irqrestore(&rtwusb->tx_lock, flags);
+			break;
+		}
+		if (!(rtwusb->tx_recovery_pending & BIT(ep))) {
+			spin_unlock_irqrestore(&rtwusb->tx_lock, flags);
+			continue;
+		}
+		rtwusb->tx_recovery_pending &= ~BIT(ep);
+		recover = rtwusb->tx_state[ep] == RTW_USB_TX_RECOVERING;
+		spin_unlock_irqrestore(&rtwusb->tx_lock, flags);
+
+		usb_kill_anchored_urbs(&rtwusb->tx_anchor[ep]);
+		ret = 0;
+		if (recover) {
+			dev_info(rtwdev->dev,
+				 "USB TX ep 0x%02x drained; clearing halt\n",
+				 rtwusb->out_ep[ep]);
+			ret = usb_clear_halt(rtwusb->udev,
+					     usb_sndbulkpipe(rtwusb->udev,
+							     rtwusb->out_ep[ep]));
+			if (ret)
+				dev_err(rtwdev->dev,
+					"USB TX ep 0x%02x clear-halt failed: %d\n",
+					rtwusb->out_ep[ep], ret);
+			else
+				dev_info(rtwdev->dev,
+					 "USB TX ep 0x%02x clear-halt complete; awaiting TX completion\n",
+					 rtwusb->out_ep[ep]);
+		}
+
+		spin_lock_irqsave(&rtwusb->tx_lock, flags);
+		if (recover && !rtwusb->tx_stopped) {
+			rtwusb->tx_state[ep] = ret ? RTW_USB_TX_FAILED :
+						   RTW_USB_TX_VERIFY;
+			if (!ret)
+				queue_work(rtwusb->txwq, &rtwusb->tx_work);
+		}
+		failed = rtwusb->tx_state[ep] == RTW_USB_TX_FAILED;
+		spin_unlock_irqrestore(&rtwusb->tx_lock, flags);
+		if (failed)
+			rtw_usb_purge_tx_queue(rtwdev, &rtwusb->tx_queue[ep]);
+	}
+	mutex_unlock(&rtwdev->mutex);
+}
