{
  "plugins": [
    "opencode-claude-auth-v2@latest",
    "@slkiser/opencode-quota@latest"
    // "opencode-claude-auth",
    // "opencode-gemini-auth@latest",
    // "oh-my-opencode-slim",
    // "opencode-background-agents"
  ],
  "$schema": "https://opencode.ai/config.json",
  "formatter": false,
  "model": "{env:OPENCODE_MODEL}",
  "snapshots": true,
  "agents": {
    "build": {
      "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }]
    },
    "general": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "allow" }
      ]
    },
    "explore": {
      "model": "openai/gpt-5.6-luna-fast"
    }
  },
  "share": "disabled",
  "experimental": {
    "quotaToast": {
      "maintainerAnnouncements": { "home": false },
      "showOnIdle": false,
      "showOnQuestion": false
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "chrome-devtools-mcp@latest",
          "--autoConnect"
        ]
      },
      "brave-search": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@brave/brave-search-mcp-server",
          "--transport",
          "stdio"
        ]
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp",
          "--api-key",
          "{env:CONTEXT7_API_KEY}"
        ]
      }
    }
  },
  "providers": {
    // Override Codex OAuth clamp (400k/272k/128k) for GPT-6.
    // Codex 0.149.0 advertises max_context_window 872000 for sol/terra/luna;
    // long context is configurable per OpenAI docs. -fast variants are
    // separate catalog entries and must be overridden explicitly.
    "openai": {
      "models": {
        "gpt-6-astra": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6-astra-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6.1-sol": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6.1-sol-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6-sol": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6-sol-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-5.6-sol": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-5.6-sol-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6-luna": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6-luna-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        }
      }
    },
    "NRP": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "NRP",
      "settings": {
        "baseURL": "https://ellm.nrp-nautilus.io/v1",
        "apiKey": "{env:NRP_API_KEY}"
      },
      "models": {
        "qwen3": {
          "name": "Qwen/Qwen3.8-Flash-Next-FP8",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoning_effort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoning_effort": "medium"
              }
            },
            {
              "id": "instruct",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ]
        },
        "qwen3-small": {
          "name": "Qwen/Qwen3.8-27B",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoning_effort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoning_effort": "medium"
              }
            },
            {
              "id": "instruct",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ]
        },
        "glm-5": {
          "name": "Inferact/GLM-5.3-NVFP4",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "chat_template_kwargs": {
                  "reasoning_effort": "low"
                }
              }
            },
            {
              "id": "high",
              "settings": {
                "chat_template_kwargs": {
                  "reasoning_effort": "high"
                }
              }
            }
          ]
        },
        "deepseek-v4-flash": {
          "name": "deepseek-ai/DeepSeek-V4-Flash-Vision-Exp",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "chat_template_kwargs": {
                  "reasoning_effort": "low"
                }
              }
            },
            {
              "id": "high",
              "settings": {
                "chat_template_kwargs": {
                  "reasoning_effort": "high"
                }
              }
            },
            {
              "id": "instruct",
              "settings": {
                "chat_template_kwargs": {
                  "thinking": false
                }
              }
            }
          ]
        },
        "kimi": {
          "name": "moonshotai/Kimi-K2.7-Code",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        },
        "minimax-m2": {
          "name": "MiniMaxAI/MiniMax-M2.7",
          "limit": {
            "context": 204800,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "gpt-oss": {
          "name": "openai/gpt-oss-120b",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "gemma": {
          "name": "google/gemma-4-31B-it-qat-w4a16-ct",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "instruct",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ]
        },
        "gemma-small": {
          "name": "google/gemma-4-12B-it-qat-w4a16-ct",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "instruct",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ]
        }
      }
    },
    "alibaba-cn": {
      "models": {
        "glm-5.3": {
          "modelID": "ZHIPU/GLM-5.3",
          "name": "ZHIPU/GLM-5.3",
          "limit": {
            "context": 1048576,
            "input": 1048576,
            "output": 131072
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoning_effort": "low"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoning_effort": "high"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoning_effort": "max"
              }
            }
          ]
        }
      }
    },
    "openrouter": {
      "models": {
        "openai/gpt-oss-20b": {
          "body": {
            "provider": {
              "order": [
                "groq"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "openai/gpt-oss-120b": {
          "body": {
            "provider": {
              "order": [
                "cerebras"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "qwen/qwen3-coder-30b-a3b-instruct": {
          "body": {
            "provider": {
              "order": [
                "alibaba"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "deepseek/deepseek-v4-flash-0731": {
          "body": {
            "provider": {
              "order": [
                "wafer/fast"
              ],
              "allow_fallbacks": false
            }
          }
        }
      },
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "websearch_cited": {
          "model": "google/gemini-3.1-pro-preview"
        }
      }
    },
    "llama.cpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen-3.6-27B": {
          "name": "Qwen 3.6 27B (local)",
          "limit": {
            "context": 262144,
            "output": 131072
          }
        },
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next (local)",
          "limit": {
            "context": 262144,
            "output": 131072
          }
        }
      }
    },
    "deepseek": {
      "settings": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "variants": [
            {
              "id": "instruct",
              "body": {
                "thinking": {
                  "type": "disabled"
                }
              }
            }
          ]
        }
      }
    }
  },
  "lsp": true,
  "websearch": {
    "provider": "random"
  },
  "provider": {
    // Detected anthropic authentication; opencode-quota added this global provider declaration.
    "anthropic": {},
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {},
    // Detected opencode-go authentication; opencode-quota added this global provider declaration.
    "opencode-go": {}
  }
}
