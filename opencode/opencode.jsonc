{
  "plugin": [
    "opencode-claude-auth-v2@latest"
    // "opencode-claude-auth",
    // "opencode-gemini-auth@latest",
    // "oh-my-opencode-slim",
    // "opencode-background-agents"
  ],
  "$schema": "https://opencode.ai/config.json",
  "formatter": false,
  "model": "{env:OPENCODE_MODEL}",
  "snapshot": true,
  "agent": {
    "build": {
      "permission": {
        "*": "allow"
      }
    },
    "general": {
      "permission": {
        "*": "allow",
        "external_directory": "allow"
      }
    },
    "explore": {
      "model": "openai/gpt-5.6-luna-fast"
    }
  },
  "share": "disabled",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server",
        "--transport",
        "stdio"
      ]
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ]
    }
  },
  "provider": {
    // Override Codex OAuth clamp (400k/272k/128k) for GPT-5.6.
    // Codex 0.149.0 advertises max_context_window 872000 for sol/terra/luna;
    // long context is configurable per OpenAI docs. -fast variants are
    // separate catalog entries and must be overridden explicitly.
    "openai": {
      "models": {
        "gpt-6-astra": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6-astra-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-5.6-sol": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-5.6-sol-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-5.6-terra": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-5.6-terra-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-5.6-luna": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-5.6-luna-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        }
      }
    },
    "NRP": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NRP",
      "options": {
        "baseURL": "https://ellm.nrp-nautilus.io/v1",
        "apiKey": "{env:NRP_API_KEY}"
      },
      "models": {
        "qwen3": {
          "name": "Qwen/Qwen3.8-Flash-Next-FP8",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "variants": {
            "low": {
              "reasoning_effort": "low"
            },
            "medium": {
              "reasoning_effort": "medium"
            },
            "instruct": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            }
          }
        },
        "qwen3-small": {
          "name": "Qwen/Qwen3.8-27B",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "variants": {
            "low": {
              "reasoning_effort": "low"
            },
            "medium": {
              "reasoning_effort": "medium"
            },
            "instruct": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            }
          }
        },
        "glm-5": {
          "name": "Inferact/GLM-5.3-NVFP4",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true,
          "variants": {
            "low": {
              "chat_template_kwargs": {
                "reasoning_effort": "low"
              }
            },
            "high": {
              "chat_template_kwargs": {
                "reasoning_effort": "high"
              }
            }
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek-ai/DeepSeek-V4-Flash-Vision-Exp",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "variants": {
            "low": {
              "chat_template_kwargs": {
                "reasoning_effort": "low"
              }
            },
            "high": {
              "chat_template_kwargs": {
                "reasoning_effort": "high"
              }
            },
            "instruct": {
              "chat_template_kwargs": {
                "thinking": false
              }
            }
          }
        },
        "kimi": {
          "name": "moonshotai/Kimi-K2.7-Code",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true,
          "attachment": true
        },
        "minimax-m2": {
          "name": "MiniMaxAI/MiniMax-M2.7",
          "limit": {
            "context": 204800,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true
        },
        "gpt-oss": {
          "name": "openai/gpt-oss-120b",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true
        },
        "gemma": {
          "name": "google/gemma-4-31B-it-qat-w4a16-ct",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "variants": {
            "instruct": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            }
          }
        },
        "gemma-small": {
          "name": "google/gemma-4-12B-it-qat-w4a16-ct",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "variants": {
            "instruct": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            }
          }
        }
      }
    },
    "alibaba-cn": {
      "models": {
        "glm-5.3": {
          "modelID": "ZHIPU/GLM-5.3",
          "name": "ZHIPU/GLM-5.3",
          "limit": {
            "context": 1048576,
            "input": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true,
          "variants": {
            "low": {
              "reasoning_effort": "low"
            },
            "high": {
              "reasoning_effort": "high"
            },
            "max": {
              "reasoning_effort": "max"
            }
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "openai/gpt-oss-20b": {
          "options": {
            "provider": {
              "order": [
                "groq"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "openai/gpt-oss-120b": {
          "options": {
            "provider": {
              "order": [
                "cerebras"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "qwen/qwen3-coder-30b-a3b-instruct": {
          "options": {
            "provider": {
              "order": [
                "alibaba"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "deepseek/deepseek-v4-flash-0731": {
          "options": {
            "provider": {
              "order": [
                "wafer/fast"
              ],
              "allow_fallbacks": false
            }
          }
        }
      },
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "websearch_cited": {
          "model": "google/gemini-3.1-pro-preview"
        }
      }
    },
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen-3.6-27B": {
          "name": "Qwen 3.6 27B (local)",
          "limit": {
            "context": 262144,
            "output": 131072
          }
        },
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next (local)",
          "limit": {
            "context": 262144,
            "output": 131072
          }
        }
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    }
  },
  "lsp": true,
  "websearch": {
    "provider": "random"
  }
}
