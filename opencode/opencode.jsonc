{
  "plugins": [
    "opencode-claude-auth@latest",
    "@slkiser/opencode-quota@latest"
    // "opencode-claude-auth",
    // "opencode-gemini-auth@latest",
    // "oh-my-opencode-slim",
    // "opencode-background-agents"
  ],
  "$schema": "https://opencode.ai/config.json",
  "formatter": false,
  "model": "{env:OPENCODE_MODEL}",
  "snapshots": true,
  "agents": {
    "build": {
      "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }]
    },
    "general": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "allow" }
      ]
    },
    "explore": {
      "model": "openai/gpt-5.6-luna-fast"
    }
  },
  "share": "disabled",
  "mcp": {
    "servers": {
      // "chrome-devtools": {
      //   "type": "local",
      //   "command": [
      //     "npx",
      //     "chrome-devtools-mcp@latest",
      //     "--autoConnect",
      //     "--userDataDir=/home/qsdrqs/.config/chromium"
      //   ]
      // },
      "brave-search": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@brave/brave-search-mcp-server",
          "--transport",
          "stdio"
        ]
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "codex-connectors": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@wileai/codex-connectors-mcp@0.2.0"
        ],
        "environment": {
          // CODEX_CONNECTORS_ALLOW omitted: expose every enabled and callable app.
          "CODEX_CONNECTORS_WEB_SEARCH": "indexed"
        }
      },
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ],
      "enabled": true
    }
  },
  "providers": {
    // models.dev does not publish Claude Mythos under the anthropic catalog;
    // limits and effort levels mirror the Claude Code model catalog.
    "anthropic": {
      "models": {
        "claude-mythos-5-1": {
          "name": "Claude Mythos 5.1",
          "limit": { "context": 1000000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh", "max"]
            }
          }
        }
      }
    },
    // Override Codex OAuth clamp (400k/272k/128k) for GPT-6.
    // Codex 0.149.0 advertises max_context_window 872000 for sol/terra/luna;
    // long context is configurable per OpenAI docs. -fast variants are
    // separate catalog entries and must be overridden explicitly.
    "openai": {
      "models": {
        "gpt-6-astra": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6-astra-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6.1-sol": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6.1-sol-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6-sol": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6-sol-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-5.6-sol": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-5.6-sol-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6-luna": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        },
        "gpt-6-luna-fast": {
          "limit": { "context": 1050000, "input": 872000, "output": 128000 }
        }
      }
    },
    "NRP": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "NRP",
      "settings": {
        "baseURL": "https://ellm.nrp-nautilus.io/v1",
        "apiKey": "{env:NRP_API_KEY}"
      },
      "models": {
        "qwen3": {
          "name": "Qwen/Qwen3.8-Flash-Next-FP8",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoning_effort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoning_effort": "medium"
              }
            },
            {
              "id": "instruct",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ]
        },
        "qwen3-small": {
          "name": "Qwen/Qwen3.8-27B",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoning_effort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoning_effort": "medium"
              }
            },
            {
              "id": "instruct",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ]
        },
        "glm-5": {
          "name": "Inferact/GLM-5.3-NVFP4",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "chat_template_kwargs": {
                  "reasoning_effort": "low"
                }
              }
            },
            {
              "id": "high",
              "settings": {
                "chat_template_kwargs": {
                  "reasoning_effort": "high"
                }
              }
            }
          ]
        },
        "deepseek-v4-flash": {
          "name": "deepseek-ai/DeepSeek-V4-Flash-Vision-Exp",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "chat_template_kwargs": {
                  "reasoning_effort": "low"
                }
              }
            },
            {
              "id": "high",
              "settings": {
                "chat_template_kwargs": {
                  "reasoning_effort": "high"
                }
              }
            },
            {
              "id": "instruct",
              "settings": {
                "chat_template_kwargs": {
                  "thinking": false
                }
              }
            }
          ]
        },
        "kimi": {
          "name": "moonshotai/Kimi-K2.7-Code",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        },
        "minimax-m2": {
          "name": "MiniMaxAI/MiniMax-M2.7",
          "limit": {
            "context": 204800,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "gpt-oss": {
          "name": "openai/gpt-oss-120b",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "gemma": {
          "name": "google/gemma-4-31B-it-qat-w4a16-ct",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "instruct",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ]
        },
        "gemma-small": {
          "name": "google/gemma-4-12B-it-qat-w4a16-ct",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "instruct",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ]
        }
      }
    },
    "alibaba-cn": {
      "models": {
        "glm-5.3": {
          "modelID": "ZHIPU/GLM-5.3",
          "name": "ZHIPU/GLM-5.3",
          "limit": {
            "context": 1048576,
            "input": 1048576,
            "output": 131072
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoning_effort": "low"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoning_effort": "high"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoning_effort": "max"
              }
            }
          ]
        }
      }
    },
    "openrouter": {
      "models": {
        "openai/gpt-oss-20b": {
          "body": {
            "provider": {
              "order": [
                "groq"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "openai/gpt-oss-120b": {
          "body": {
            "provider": {
              "order": [
                "cerebras"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "qwen/qwen3-coder-30b-a3b-instruct": {
          "body": {
            "provider": {
              "order": [
                "alibaba"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "deepseek/deepseek-v4-flash-0731": {
          "body": {
            "provider": {
              "order": [
                "wafer/fast"
              ],
              "allow_fallbacks": false
            }
          }
        }
      },
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "websearch_cited": {
          "model": "google/gemini-3.1-pro-preview"
        }
      }
    },
    "llama.cpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen-3.6-27B": {
          "name": "Qwen 3.6 27B (local)",
          "limit": {
            "context": 262144,
            "output": 131072
          }
        },
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next (local)",
          "limit": {
            "context": 262144,
            "output": 131072
          }
        }
      }
    },
    "deepseek": {
      "settings": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "variants": [
            {
              "id": "instruct",
              "body": {
                "thinking": {
                  "type": "disabled"
                }
              }
            }
          ]
        }
      }
    },
    // The catalog entry for this provider reads ABLIT_KEY; the key available
    // here is exported as ABLITERATION_API_KEY.
    "abliteration-ai": {
      "settings": {
        "apiKey": "{env:ABLITERATION_API_KEY}"
      },
      "models": {
        // models.dev does not list Large Flash yet.
        "abliterated-model-large-flash": {
          "name": "Abliterated Large Flash",
          "limit": {
            "context": 1048576,
            "output": 262144
          },
          "cost": {
            "input": 1,
            "output": 2,
            "cache": { "read": 0.1, "write": 1 }
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        // models.dev pricing for this model is stale; values follow the official pricing page.
        "abliterated-model-large-v2": {
          "cost": {
            "input": 3,
            "output": 5,
            "cache": { "read": 0.3, "write": 3 }
          }
        }
      }
    },
    // Local Strata server (~/Strata, `nix develop -c ./run-iq3_xxs.sh`).
    // Thinking defaults to xhigh effort; the official variant turns off the refusal-direction projection.
    "strata": {
      "name": "Strata (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "strata-local"
      },
      "models": {
        "qwen3.8-flash-next": {
          "modelID": "qwen3.8-flash-next-iq3_xxs",
          "name": "Qwen3.8-Flash-Next IQ3_XXS (local)",
          "limit": {
            "context": 262144,
            "input": 229376,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "variants": [
            {
              "id": "low",
              "body": {
                "reasoning_effort": "low"
              }
            },
            {
              "id": "medium",
              "body": {
                "reasoning_effort": "medium"
              }
            },
            {
              "id": "xhigh",
              "body": {
                "reasoning_effort": "xhigh"
              }
            },
            {
              "id": "instruct",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            },
            {
              "id": "official",
              "body": {
                "experimental_speed_projection": false
              }
            }
          ]
        }
      }
    }
  },
  "lsp": true,
  "websearch": {
    "provider": "random"
  },
  "provider": {
    // Detected anthropic authentication; opencode-quota added this global provider declaration.
    "anthropic": {},
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {},
    // Detected opencode-go authentication; opencode-quota added this global provider declaration.
    "opencode-go": {},
    // Detected opencode authentication; opencode-quota added this global provider declaration.
    "opencode": {}
  }
}
